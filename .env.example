# =============================================================================
# .env.example — plantilla de variables de entorno
#
# QUÉ ES ESTO: las "variables de entorno" son los datos secretos que la app
# necesita (llaves de servicios, contraseñas de la base de datos). Van aparte
# del código para que nunca terminen publicados en GitHub.
#
# CÓMO SE USA:
#   1. Copiar este archivo:  cp .env.example .env.local
#   2. Llenar .env.local con los valores reales
#   3. Cargar los mismos valores en Vercel → Settings → Environment Variables
#
# .env.local está en .gitignore. Este archivo (.env.example) SÍ se sube,
# porque documenta qué hace falta, sin revelar ningún valor.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Panel de Supabase → Project Settings → API

# La dirección del proyecto. Es pública, no pasa nada si alguien la ve.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Llave "anónima". También es pública: va dentro del navegador. Es segura
# SOLO porque tenemos RLS activado — es lo que hace que RLS no sea opcional.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# Llave de servicio. SECRETA. Se salta TODAS las reglas de RLS.
# Solo se usa en el servidor (webhooks, panel de admin). Si esta se filtra,
# quien la tenga puede leer y borrar toda la base de datos.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx


# --- Resend (correos) --------------------------------------------------------
# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Desde qué dirección salen los correos. El dominio tiene que estar verificado
# en Resend, si no los correos se van a spam o no salen.
CORREO_REMITENTE="Prestamo <hola@tudominio.com>"


# --- Recurrente (pagos) ------------------------------------------------------
# Panel de Recurrente → sección de desarrolladores
# Empezar SIEMPRE con las llaves de PRUEBA (sandbox). Las reales hasta la Fase 3.
RECURRENTE_PUBLIC_KEY=pk_test_xxxxxxxx
RECURRENTE_SECRET_KEY=sk_test_xxxxxxxx

# Con esto se verifica que un aviso de pago venga de verdad de Recurrente
# y no de alguien haciéndose pasar por ellos.
RECURRENTE_WEBHOOK_SECRET=whsec_xxxxxxxx


# --- Configuración del negocio -----------------------------------------------

# Comisión de la plataforma, como decimal. 0.15 = 15%.
# Está aquí y no en el código para poder bajarla a 0 durante el lanzamiento
# sin tener que volver a desplegar (ver PLAN.md sección 6, punto 4).
COMISION_PLATAFORMA=0.15

# La dirección pública del sitio. En local es localhost; en Vercel es la URL real.
# Se usa para armar los enlaces de los correos y el retorno del pago.
NEXT_PUBLIC_URL_SITIO=http://localhost:3000


# --- Demo académica -----------------------------------------------------------
# ⚠️ Enciende el botón de "pago simulado", que marca reservas como pagadas SIN
# cobrar nada. Es solo para poder mostrar el circuito completo en una
# presentación. En cualquier despliegue de verdad, esta variable NO debe existir.
PAGOS_SIMULADOS=true
